#!/bin/sh
# Alt Army pre-commit hook (enabled by `npm install` in addon/, or `npm run hooks:install` there).
# When the commit touches addon/, blocks it if addon/AltArmy_TBC/Data/Economy/WaylaidCrates.lua is out of
# date with the site's game data (site/data/altarmy-profit.sqlite). Skips when that database or Python isn't
# there, and does nothing for a commit that leaves addon/ alone.

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '^addon/'; then
    exit 0
fi
cd addon || exit 1

PY=""
for cand in python3 python py; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: Python not found, skipping the Waylaid Crates check."
    exit 0
fi

"$PY" scripts/generate-waylaid-crates.py --check || {
    echo "pre-commit: commit blocked. (Bypass once with git commit --no-verify.)"
    exit 1
}
