# The staging site's own Firebase project (public web config: every browser receives these values). A Spark
# project with no billing account, holding only Firebase Auth, so staging accounts never touch prod's.
# deploy/deploy.sh sets these on the staging Cloud Run service; `npm run dev:staging-auth` loads this file.
FIREBASE_PROJECT_ID=alt-army-staging
FIREBASE_API_KEY=AIzaSyCpH4zGuLz7SOExvI7VOTVJxrcxhjpL_0I
FIREBASE_AUTH_DOMAIN=alt-army-staging.firebaseapp.com
