{
  "name": "altarmy-profit",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-ports.mjs 9099 8080 9150 4400 4500 8600 5173",
    "dev":"concurrently --kill-others --names auth,api,web --prefix-colors magenta,blue,green \"npm:dev:auth\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:auth": "node scripts/dev-auth.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "wait-on --timeout 300000 tcp:127.0.0.1:9099 tcp:127.0.0.1:8080 http-get://127.0.0.1:8600/api/config && npm --prefix frontend run dev -- --open",
    "predev:staging-auth": "node scripts/free-ports.mjs 8600 5173",
    "dev:staging-auth":"concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:dev:api -- --staging-auth\" \"npm:dev:web:staging-auth\"",
    "dev:web:staging-auth": "wait-on --timeout 120000 http-get://127.0.0.1:8600/api/config && npm --prefix frontend run dev -- --open"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "firebase-tools": "^14.27.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "typescript": "^5.9.0"
  }
}
